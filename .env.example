# Memory Maker - Environment Variables
# Never commit actual values to version control.

# Google OAuth Web Client credentials
# Google Cloud Console > APIs & Services > Credentials > Create Credentials > OAuth client ID
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# For local development, add this exact redirect URI to your OAuth client.
# For production, set this to https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Optional: upload into a specific folder in the signed-in user's Drive.
# Leave blank to upload into the signed-in user's Drive root.
GOOGLE_DRIVE_FOLDER_ID=

# Optional for deployment/serverless.
# Local dev stores this in .google-oauth-token.json after login.
GOOGLE_OAUTH_REFRESH_TOKEN=

# The public URL of your deployed frontend (used for CORS and OAuth redirects).
# For local development, leave blank (defaults to http://localhost:5173).
# For production on Vercel, set to your deployment URL, e.g. https://your-app.vercel.app
FRONTEND_URL=
